-- ===== 1. ПЕРЕХВАТ РОЛЕЙ (Nx-Crazy) =====
-- ================================================
local Roles = { Murderer = nil, Sheriff = nil }
local WeaponNames = {
    Knife = { Index = "Murderer", Color = Color3.fromRGB(255, 0, 0) },
    Gun = { Index = "Sheriff", Color = Color3.fromRGB(0, 0, 255) }
}

local function getPlayerRole(plr)
    if not plr.Character then return "Неизвестно", Color3.fromRGB(255, 255, 255) end
    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            local role = WeaponNames[child.Name]
            if role then
                if role.Index == "Murderer" then Roles.Murderer = plr
                elseif role.Index == "Sheriff" then Roles.Sheriff = plr end
                return role.Index, role.Color
            end
        end
    end
    if plr.Character then
        for _, child in ipairs(plr.Character:GetChildren()) do
            if child:IsA("Tool") then
                local role = WeaponNames[child.Name]
                if role then
                    if role.Index == "Murderer" then Roles.Murderer = plr
                    elseif role.Index == "Sheriff" then Roles.Sheriff = plr end
                    return role.Index, role.Color
                end
            end
        end
    end
    return "Невинный", Color3.fromRGB(0, 255, 0)
end

-- ================================================
-- ===== 2. ESP (Nx-Crazy + v3.2.1) =====
-- ================================================
local espInstances = {}

local function createESPBox(part, color, text)
    if not part then return end
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("BoxHandleAdornment") or child:IsA("BillboardGui") then child:Destroy() end
    end
    local box = Instance.new("BoxHandleAdornment")
    box.Size = part.Size + Vector3.new(0.1, 0.1, 0.1)
    box.Name = "ESP_Box"
    box.Visible = settings.espEnabled
    box.Adornee = part
    box.Color3 = color
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Transparency = 0.4
    box.Parent = part
    table.insert(espInstances, box)
    if text then
        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 120, 0, 30)
        billboard.Adornee = part
        billboard.Parent = part
        billboard.AlwaysOnTop = true
        local label = Instance.new("TextLabel", billboard)
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = color
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold
        label.TextStrokeTransparency = 0.3
        table.insert(espInstances, billboard)
    end
end

local function updateESP()
    for _, obj in ipairs(espInstances) do pcall(function() obj:Destroy() end) end
    espInstances = {}
    if not settings.espEnabled then return end
    for _, plr in ipairs(game.Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local roleName, roleColor = getPlayerRole(plr)
            if (roleName == "Murderer" and not settings.showMurderer) or
               (roleName == "Sheriff" and not settings.showSheriff) or
               (roleName == "Невинный" and not settings.showInnocent) then continue end
            local text = plr.Name
            if settings.showDistance then
                local dist = (plr.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude
                text = text .. " | " .. math.floor(dist) .. "m"
            end
            createESPBox(plr.Character.HumanoidRootPart, roleColor, text)
        end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Tool") and obj.Name:lower():find("gun") and obj.Parent ~= player.Character and obj.Parent ~= player.Backpack then
            createESPBox(obj:FindFirstChild("Handle") or obj, Color3.fromRGB(255, 200, 0), "🔫 Пистолет")
        end
    end
end

-- ================================================
-- ===== 3. SILENT AIM (Nx-Crazy) =====
-- ================================================
local RaycastParams = RaycastParams.new()
RaycastParams.IgnoreWater = true
RaycastParams.FilterType = Enum.RaycastFilterType.Blacklist
RaycastParams.FilterDescendantsInstances = {player.Character}

local function getClosestPlayer()
    local closest, minDist = nil, math.huge
    for _, plr in ipairs(game.Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (plr.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude
            if dist < minDist then minDist = dist; closest = plr end
        end
    end
    return closest
end

local rawMetatable = getrawmetatable(game)
local oldNameCall = rawMetatable.__namecall
setreadonly(rawMetatable, false)
rawMetatable.__namecall = newcclosure(function(object, ...)
    local method = getnamecallmethod()
    local args = {...}
    if settings.silentAim then
        if method == "FireServer" and tostring(object) == "Throw" then
            local closest = getClosestPlayer()
            if closest and closest.Character then
                local primary = closest.Character.HumanoidRootPart
                local result = workspace:Raycast(rootPart.Position, (primary.Position - rootPart.Position).Unit * 200, RaycastParams)
                if result then args[2] = result.Position end
            end
        elseif method == "InvokeServer" and tostring(object) == "ShootGun" and Roles.Murderer then
            local primary = Roles.Murderer.Character.HumanoidRootPart
            args[2] = primary.Position + primary.AssemblyLinearVelocity / 40
        end
    end
    return oldNameCall(object, unpack(args))
end)
setreadonly(rawMetatable, true)

