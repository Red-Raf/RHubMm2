-- ===== 4. KILL ALL (v3.2.1) =====
-- ================================================
local function killAll()
    if not settings.killAll then return end
    local murderer = Roles.Murderer
    if not murderer or murderer == player then return end
    local killRemote = ReplicatedStorage:FindFirstChild("Kill") or ReplicatedStorage:FindFirstChild("Hit")
    if killRemote then
        for _, plr in ipairs(game.Players:GetPlayers()) do
            if plr ~= player and plr ~= murderer and plr.Character then
                pcall(function() killRemote:FireServer(plr) end)
                wait(0.1)
            end
        end
    end
end

